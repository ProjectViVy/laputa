@@ -0,0 +1,211 @@
+"""Behavior contracts for the opt-in, same-review persona extension."""
+import importlib
+from types import SimpleNamespace
+import threading
+import pytest
+
+
+def test_frozen_projection_reaches_real_spawn_and_same_worker(tmp_path, monkeypatch):
+    from agent import background_review as review, persona_stage as stage
+    from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest
+    from tests.agent.test_background_review import _bare_agent, ImmediateThread
+    import run_agent
+    parent = _bare_agent()
+    parent._session_db = SimpleNamespace(db_path=tmp_path / 'state.db')
+    parent.platform = 'cli'
+    manager = PluginManager(scope_key=str(tmp_path))
+    manager._cli_ref = object()
+    ctx = PluginContext(PluginManifest(name='synthetic-persona'), manager)
+    observed = []
+    handle = ctx.register_background_review_persona_stage(
+        lambda c: observed.append(tuple(i.text for i in c.items)) or 'no_change',
+        authorize=lambda meta: True)
+    class Fork:
+        _session_messages = []
+        def run_conversation(self, **kwargs):
+            return {'completed': True}
+        def release_clients(self):
+            pass
+    try:
+        request = stage.capture_current_turn(parent, 'visible user', 'visible reply', 't')
+        assert request is not None
+        monkeypatch.setattr(run_agent.threading, 'Thread', ImmediateThread)
+        monkeypatch.setattr(run_agent, '_review_should_defer', lambda *a: False)
+        monkeypatch.setattr(review, 'load_background_review_settings', lambda: (True, {}))
+        monkeypatch.setattr(review, '_parent_can_emit_tool_calls', lambda *a: True)
+        monkeypatch.setattr(review, 'build_cache_parity_fork', lambda *a, **k: (Fork(), None, False))
+        monkeypatch.setattr(review, '_review_tool_whitelist', lambda *a: (set(), set()))
+        monkeypatch.setattr(review, '_snapshot_review_usage', lambda *a: {})
+        monkeypatch.setattr(review, '_record_review_usage_to_parent', lambda *a: None)
+        parent._spawn_background_review([], persona_request=request)
+        assert observed == [('visible user', 'visible reply')]
+        assert parent._background_review_run is None
+    finally:
+        handle.dispose()
+
+
+def test_real_plugin_context_registers_profile_scoped_stage_and_disposes(tmp_path):
+    from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest
+    from hermes_constants import get_hermes_home
+    from agent import persona_stage as stage
+    manager = PluginManager(scope_key=str(tmp_path))
+    ctx = PluginContext(PluginManifest(name='synthetic-persona'), manager)
+    observed = []
+    def authorize(meta):
+        assert get_hermes_home().resolve() == tmp_path.resolve()
+        return True
+    def callback(stage_context):
+        assert get_hermes_home().resolve() == tmp_path.resolve()
+        observed.append(stage_context.home)
+        return 'no_change'
+    handle = ctx.register_background_review_persona_stage(callback, authorize=authorize)
+    try:
+        request = stage.capture_turn(home=tmp_path, surface='cli', session_id='s', turn_id='t',
+                                     user_text='visible', assistant_text='response')
+        assert stage.invoke(request, SimpleNamespace(cancel_requested=threading.Event()),
+                            {'completed': True}) == 'no_change'
+        assert observed == [tmp_path.resolve()]
+    finally:
+        handle.dispose()
+    assert stage.capture_turn(home=tmp_path, surface='cli', session_id='s', turn_id='t',
+                              user_text='visible', assistant_text='response') is None
+
+
+def test_real_review_worker_keeps_persona_inside_parent_lifecycle(tmp_path, monkeypatch):
+    from agent import background_review as review
+    from agent import persona_stage as stage
+    parent = SimpleNamespace(_background_review_lock=threading.Lock(),
+        _background_review_run=None, _background_review_agent=None,
+        _safe_print=lambda *a: None, background_review_callback=None,
+        memory_notifications='off', _emit_auxiliary_failure=lambda *a: None)
+    class Fork:
+        _session_messages = []
+        released = False
+        def run_conversation(self, **kwargs):
+            return {'completed': True, 'failed': False, 'interrupted': False}
+        def release_clients(self):
+            self.released = True
+    fork = Fork()
+    monkeypatch.setattr(review, '_parent_can_emit_tool_calls', lambda *a: True)
+    monkeypatch.setattr(review, 'build_cache_parity_fork', lambda *a, **kw: (fork, None, False))
+    monkeypatch.setattr(review, '_review_tool_whitelist', lambda *a: (set(), set()))
+    monkeypatch.setattr(review, '_snapshot_review_usage', lambda *a: {})
+    monkeypatch.setattr(review, '_record_review_usage_to_parent', lambda *a: None)
+    run = review.prepare_background_review_run(parent)
+    observed = []
+    def callback(ctx):
+        assert parent._background_review_run is run
+        assert not run.request_done.is_set()
+        assert fork.released
+        observed.append(threading.get_ident())
+        return 'no_change'
+    entry = stage.register_stage(tmp_path, 'fixture-plugin', callback, authorize=lambda meta: True)
+    try:
+        request = stage.capture_turn(home=tmp_path, surface='cli', session_id='s', turn_id='t',
+                                     user_text='visible', assistant_text='response')
+        review._run_review_in_thread(parent, [], 'review', review_run=run, persona_request=request)
+        assert observed == [threading.get_ident()]
+        assert run.request_done.is_set()
+        assert parent._background_review_run is None
+        assert parent._last_persona_review_status == 'no_change'
+    finally:
+        entry.dispose()
+
+
+def test_native_cancel_token_fences_commit_and_detaches_closed_fork():
+    from agent.background_review import _BackgroundReviewRun
+    run = _BackgroundReviewRun()
+    assert run.begin_request(object())
