+++ b/hermes_cli/plugins_persona.py
@@ -0,0 +1,30 @@
+"""Optional, profile-owned continuation inside the native background review worker."""
+from .plugins_loader import _plugin_home_scope, _serialized_replacement
+
+@_serialized_replacement
+def register_background_review_persona_stage(self, callback, *, authorize, max_evidence_chars=16000):
+    """Register one synchronous stage for this home; no inputs until explicit consent.
+
+    authorize receives immutable metadata only. Unload invalidates late commit admission.
+    This continuation is in-process only, not a fire-and-forget observer callback.
+    """
+    if self._load_abandoned:
+        return None
+    if not callable(callback) or not callable(authorize):
+        raise TypeError('stage and authorization callbacks must be callable')
+    from agent.persona_stage import register_stage
+    home = self._manager.home_path
+    def bound_authorize(metadata):
+        with _plugin_home_scope(home):
+            return authorize(metadata)
+    def bound_callback(stage_context):
+        with _plugin_home_scope(home):
+            return callback(stage_context)
+    entry = register_stage(home, self.plugin_id, bound_callback, authorize=bound_authorize,
+                           local_cli=lambda: getattr(self._manager, '_cli_ref', None) is not None,
+                           max_chars=max_evidence_chars)
+    try:
+        return self._track('background_review_persona_stage', self.plugin_id, entry.dispose)
+    except Exception:
+        entry.dispose()
+        raise
