new file mode 100644
index 0000000000..b410d6bb9d
--- /dev/null
+++ b/agent/persona_stage.py
@@ -0,0 +1,163 @@
+"""Opt-in persona continuation of an existing background review, scoped by home.
+
+No executor, new worker, persistence or model calls live in this module.
+"""
+from __future__ import annotations
+from dataclasses import dataclass
+from pathlib import Path
+from types import MappingProxyType
+from typing import Protocol
+import threading
+
+_lock = threading.RLock()
+_entries = {}
+
+class ReviewRunToken(Protocol):
+    cancel_requested: threading.Event
+
+
+class StageRegistration:
+    def __init__(self, home, plugin_id, callback, authorize, local_cli, max_chars):
+        self.home = Path(home).resolve()
+        self.plugin_id = plugin_id
+        self.callback = callback
+        self.authorize = authorize
+        self.local_cli = local_cli
+        self.max_chars = max_chars
+        self.active = True
+
+    def is_current(self):
+        with _lock:
+            return self.active and _entries.get(self.home) is self
+
+    def dispose(self):
+        with _lock:
+            self.active = False
+            if _entries.get(self.home) is self:
+                del _entries[self.home]
+
+def register_stage(home, plugin_id, callback, *, authorize, local_cli=False, max_chars=16000):
+    if not callable(callback) or not callable(authorize):
+        raise TypeError('stage and consent callbacks must be callable')
+    if type(max_chars) is not int or not 0 < max_chars <= 65536:
+        raise ValueError('invalid visible-evidence budget')
+    entry = StageRegistration(home, plugin_id, callback, authorize, local_cli, max_chars)
+    with _lock:
+        if entry.home in _entries:
+            raise ValueError('a persona stage is already registered for this home')
+        _entries[entry.home] = entry
+    return entry
+
+def capture_current_turn(agent, user_text, assistant_text, turn_id):
+    """Capture at the foreground boundary, never from a later worker's ambient identity."""
+    with _lock:
+        if not _entries:
+            return None
+    from agent.system_prompt import _agent_home
+    from hermes_cli.plugin_session import session_surface
+    home = _agent_home(agent)
+    if home is None:
+        return None
+    with _lock:
+        entry = _entries.get(Path(home).resolve())
+    if entry is None:
+        return None
+    surface = session_surface()
+    local_cli = entry.local_cli() if callable(entry.local_cli) else entry.local_cli
+    if not surface and local_cli and getattr(agent, 'platform', None) in (None, 'cli', 'local'):
+        surface = 'cli'
+    try:
+        return capture_turn(home=home, surface=surface, session_id=getattr(agent, 'session_id', ''),
+                            turn_id=turn_id, user_text=user_text, assistant_text=assistant_text)
+    except Exception:
+        # Bad opt-in configuration must not suppress the native memory/skills review.
+        return None
+
+
+def capture_turn(*, home, surface, session_id, turn_id, user_text, assistant_text):
+    if home is None:
+        return None
+    with _lock:
+        entry = _entries.get(Path(home).resolve())
+    if entry is None or surface not in ('cli', 'local') or not session_id or not turn_id:
+        return None
+    meta = MappingProxyType(dict(home=str(entry.home), surface=surface,
+                                 session_id=str(session_id), turn_id=str(turn_id)))
+    if entry.authorize(meta) is not True:
+        return None
+    if (not isinstance(user_text, str) or not isinstance(assistant_text, str)
+            or not user_text or len(user_text) + len(assistant_text) > entry.max_chars):
+        return None
+    import uuid
+    request_id = uuid.uuid4().hex
+    items = (VisibleItem(request_id + ':user', 'user', user_text),
+             VisibleItem(request_id + ':assistant', 'assistant', assistant_text))
+    return PersonaRequest(entry, request_id, entry.home, surface, str(session_id), str(turn_id), items)
+
+
+@dataclass(frozen=True)
+class VisibleItem:
+    item_id: str
+    role: str
+    text: str
+
+
+@dataclass(frozen=True)
+class PersonaRequest:
+    entry: StageRegistration
+    request_id: str
+    home: Path
+    surface: str
+    session_id: str
+    turn_id: str
+    items: tuple[VisibleItem, ...]
+
+
+@dataclass(frozen=True)
+class PersonaStageContext:
+    request: PersonaRequest
+    run: ReviewRunToken
+
+    @property
+    def home(self):
+        return self.request.home
+
+    @property
+    def surface(self):
+        return self.request.surface
+
+    @property
+    def items(self):
+        return self.request.items
+
+    @property
+    def request_id(self):
+        return self.request.request_id
+
+    def cancelled(self):
+        return (not self.request.entry.is_current()
+                or self.run.cancel_requested.is_set())
+
+    def try_enter_commit(self):
+        enter = getattr(self.run, 'try_enter_persona_commit', None)
+        return bool(enter and enter(self.request.entry.is_current))
+
+
+def invoke(request, run, native_result):
+    if request is None or run is None:
+        return 'unsupported'
+    ctx = PersonaStageContext(request, run)
+    if ctx.cancelled():
+        return 'cancelled'
+    if (not isinstance(native_result, dict) or native_result.get('completed') is not True
+            or native_result.get('failed') or native_result.get('interrupted')
+            or native_result.get('error')):
+        return 'native_not_completed'
+    try:
+        outcome = request.entry.callback(ctx)
+        return outcome if outcome in ('no_change', 'persisted_verified', 'source_saved_host_pending',
+                                      'rejected', 'needs_user_authorization', 'cancelled',
+                                      'analysis_failed', 'unknown_outcome') else 'persona_failed'
+    except Exception:
+        # Do not put private text/provider exception strings in host logs.
+        return 'persona_failed'
