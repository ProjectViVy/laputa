+def test_authorized_visible_projection_runs_in_same_task_and_revokes(tmp_path):
+    stage = importlib.import_module('agent.persona_stage')
+    seen = []
+    thread_id = threading.get_ident()
+    def callback(ctx):
+        assert threading.get_ident() == thread_id
+        assert not ctx.cancelled()
+        seen.extend(item.text for item in ctx.items)
+        return 'no_change'
+    entry = stage.register_stage(tmp_path, 'fixture-plugin', callback, authorize=lambda meta: True)
+    try:
+        request = stage.capture_turn(home=tmp_path, surface='cli', session_id='s', turn_id='t',
+                                     user_text='visible user', assistant_text='visible assistant')
+        assert request is not None
+        run = SimpleNamespace(cancel_requested=threading.Event())
+        assert stage.invoke(request, run, {'completed': True}) == 'no_change'
+        assert seen == ['visible user', 'visible assistant']
+        entry.dispose()
+        assert stage.invoke(request, run, {'completed': True}) == 'cancelled'
+    finally:
+        entry.dispose()
